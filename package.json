{
  "name": "@ondewo/ondewo-csi-client-js",
  "version": "5.4.1",
  "description": "ONDEWO Communication System Integration (CSI) Client library for Js",
  "author": "ONDEWO GmbH <office@ondewo.com>",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "csi",
    "api",
    "client",
    "js",
    "grpc"
  ],
  "scripts": {
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --include auth/offlineTokenProvider.js --exclude \"**/*.spec.js\" --reporter text node --test auth/offlineTokenProvider.spec.js",
    "initialize": "git submodule update --init --recursive --remote",
    "build": "docker run -v ${PWD}:/input-volume -v ${PWD}/../api:/output-volume ondewo-js-proto-compiler ondewo-csi-api ondewo-csi-api ondewo",
    "debug": "docker run --entrypoint /bin/bash -v ${PWD}/src:/input-volume -v ${PWD}/src/..:/output-volume $npm_package_config_compiler",
    "publish-npm": "npm publish ../npm --access public",
    "build-update": "npm run build-only && npm run start-example",
    "start-example": "sudo cp lib/csi.js example/lib/csi.js && http-server example",
    "example-link-lib": "sudo ln -s lib/csi.js example/lib/csi.js",
    "build-sample": "docker run -v ${PWD}/src:/input-volume -v ${PWD}/src/../api:/output-volume $npm_package_config_compiler csi ondewo-csi-api ondewo-csi-api ondewo",
    "test:examples": "node --test examples/getS2sPipelineExample.spec.js"
  },
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-csi-client-js.git"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0",
    "terser-webpack-plugin": "^5.3.14",
    "undici": "^6.27.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "c8": "^11.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
